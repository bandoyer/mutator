#!/usr/bin/env bash
# Check and drive this checkout's mutator against a scratch project. Run from anywhere.
set -euo pipefail

repo=$(cd "$(dirname "$0")/../../../.." && pwd)
mutator="$repo/mutator"
scratch_prefix="$(realpath -m -- "${TMPDIR:-/tmp}")/mutator-verify."

# Prints the scratch folder that holds path $1 after resolving `..` and symlinks, or fails.
scratch_root() {
  local path rest
  path=$(realpath -m -- "$1")
  rest=${path#"$scratch_prefix"}
  [[ $rest != "$path" && -n $rest ]] || return 1
  echo "$scratch_prefix${rest%%/*}"
}

# Stops the subcommand $1 unless project $2 is inside a scratch folder `project` made,
# so a real checkout is never driven by mistake.
admit() {
  scratch_root "$2" >/dev/null || { echo "$1: refusing $2; it is not inside a verify-mutator scratch folder"; exit 1; }
}

usage() {
  cat <<USAGE
usage: verify-mutator doctor
       verify-mutator project fixture | cold-build | <git repo>
       verify-mutator drive <project> <transcript> [mutator args...]
       verify-mutator exec <project> <transcript> <command> [args...]
       verify-mutator signal <project> <transcript> TERM|INT <seconds> [mutator args...]
       verify-mutator trace <project> <transcript> [mutator args...]
       verify-mutator cleanup <project>
USAGE
  exit 2
}

# A one-function Python project whose test kills every mutant of demo.f.
write_fixture() {
  local project=$1
  mkdir -p "$project"
  printf 'def f():\n    return 1 == 1\n' >"$project/demo.py"
  printf 'from demo import f\n\n\ndef test_f():\n    assert f() is True\n' >"$project/test_demo.py"
  printf '[tool.pytest.ini_options]\ntestpaths = ["."]\n' >"$project/pyproject.toml"
  printf 'target/\n.metrics/\n' >"$project/.gitignore"
  git -C "$project" init -q
  git -C "$project" add -A
  git -C "$project" -c user.name=verify -c user.email=verify@localhost commit -qm fixture
}

# A one-function Cargo project. Its build script sleeps 6 s, like a cold build of
# real dependencies, and runs again only in a target folder that hasn't built it.
# Its one test can't fail, so a mutant can only be killed by a timeout.
write_cold_build() {
  local project=$1
  mkdir -p "$project/src" "$project/tests"
  printf '[tools]\nrust = "1.98.0"\n' >"$project/mise.toml"
  printf '[package]\nname = "demo"\nversion = "0.1.0"\nedition = "2024"\nbuild = "build.rs"\n' >"$project/Cargo.toml"
  printf 'fn main() {\n    println!("cargo:rerun-if-changed=build.rs");\n    std::thread::sleep(std::time::Duration::from_secs(6));\n}\n' >"$project/build.rs"
  printf 'pub fn f() -> i32 {\n    1\n}\n' >"$project/src/lib.rs"
  printf '#[test]\nfn accepts_anything() {\n    let _ = demo::f();\n}\n' >"$project/tests/weak.rs"
  printf 'target/\n.metrics/\nCargo.lock\n' >"$project/.gitignore"
  git -C "$project" init -q
  git -C "$project" add -A
  git -C "$project" -c user.name=verify -c user.email=verify@localhost commit -qm cold-build
}

# Lists processes still running with a working directory in the project, such as
# a test command mutator didn't stop. A worker folder already removed still counts.
leftover_processes() {
  local project=$1 entry cwd
  for entry in /proc/[0-9]*; do
    cwd=$(readlink "$entry/cwd" 2>/dev/null) || continue
    [[ $cwd == "$project" || $cwd == "$project/"* ]] || continue
    echo "${entry#/proc/} $(tr '\0' ' ' <"$entry/cmdline" 2>/dev/null)"
  done
}

# Reads an `strace -f` log of kill, wait4, waitid, and the fork calls, and prints each
# group signal (other than 0) sent after the wait that reaped that group's leader. From
# then on the group id is no longer known to be the command's own (issue #44).
signals_after_reap() {
  "$repo/.venv/bin/python" - "$1" <<'PY'
import re, sys

pending, calls = {}, []
for line in open(sys.argv[1]):
    match = re.match(r"^(\d+)\s+(.*)$", line.rstrip("\n"))
    if not match:
        continue
    tid, text = match.groups()
    if text.endswith("<unfinished ...>"):
        pending[tid] = text[: -len("<unfinished ...>")]
    elif text.startswith("<..."):
        calls.append(pending.pop(tid, "") + text.split("resumed>", 1)[1])
    else:
        calls.append(text)
reaped, signals, late = set(), 0, []
for call in calls:
    name = call.split("(", 1)[0]
    result = call.rsplit("= ", 1)[-1].split(" ")[0]
    if name in ("clone", "clone3", "fork", "vfork") and result.isdigit():
        reaped.discard(int(result))  # a new task with this number
    elif name == "wait4" and result.isdigit() and int(result) > 0:
        reaped.add(int(result))
    elif name == "waitid" and "WNOWAIT" not in call:
        found = re.search(r"si_pid=(\d+)", call)
        if found:
            reaped.add(int(found.group(1)))
    elif name == "kill":
        found = re.match(r"kill\(-(\d+), (\w+)\)", call)
        if found and found.group(2) != "0":
            signals += 1
            if int(found.group(1)) in reaped:
                late.append(call)
print(f"group signals traced (other than 0): {signals}")
print("\n".join(late) or "(none)")
PY
}

# Runs "$@" in the project and appends the action, what the user saw, and the state left behind.
record() {
  local project=$1 transcript=$2 shown=$3
  shift 3
  mkdir -p "$(dirname "$transcript")"
  local out err code
  out=$(mktemp) err=$(mktemp)
  set +e
  (cd "$project" && MISE_TRUSTED_CONFIG_PATHS="$project" MEASURE_TOOLS="$(dirname "$project")/tools" "$@") >"$out" 2>"$err"
  code=$?
  set -e
  {
    echo "\$ (cd $project) $shown"
    echo "date: $(date '+%F %T %Z')"
    echo "mutator: $(git -C "$repo" rev-parse --short HEAD)$([[ -z "$(git -C "$repo" status --porcelain -- src mutator pyproject.toml)" ]] || echo ' + uncommitted changes')"
    echo "exit code: $code"
    echo "--- stdout"; cat "$out"
    echo "--- stderr"; cat "$err"
    echo "--- worker folders left in target/mutation-workers"
    find "$project/target/mutation-workers" -mindepth 1 -maxdepth 1 2>/dev/null | sed "s|^$project/||" | grep . || echo "(none)"
    echo "--- processes left in the project"
    leftover_processes "$project" | grep . || echo "(none)"
    echo "--- tracked files changed (git status --short)"
    git -C "$project" status --short --untracked-files=no | grep . || echo "(none)"
    echo
  } | tee -a "$transcript"
  rm -f "$out" "$err"
}

case "${1:-}" in
  doctor)
    [[ -x "$mutator" ]] || { echo "doctor: no launcher at $mutator"; exit 1; }
    "$mutator" --help >/dev/null 2>&1 || { echo "doctor: $mutator --help failed; run it once to build .venv"; exit 1; }
    # A git worktree sits away from the main checkout, so its siblings are missing; name the link that fixes it.
    main=$(dirname "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)")
    for tool in crapper dryer; do
      [[ -d "$repo/../$tool/src" ]] && continue
      echo "doctor: $tool is not checked out next to mutator ($repo/../$tool)"
      [[ -d "$main/../$tool/src" ]] && echo "doctor: link the main checkout's copy: ln -s $(realpath "$main/../$tool") $(realpath -m "$repo/../$tool")"
      exit 1
    done
    # The fixture's default test command is this .venv's `python -m pytest`, and ./mutator builds .venv without pytest.
    "$repo/.venv/bin/python" -c 'import pytest' 2>/dev/null || { echo "doctor: $repo/.venv has no pytest, so the fixture's default test command fails; install it: $repo/.venv/bin/pip install -e '$repo[dev]'"; exit 1; }
    echo "doctor: ok"
    echo "mutator:  $mutator ($("$repo/.venv/bin/python" --version))"
    echo "checkout: $(git -C "$repo" rev-parse --short HEAD) on $(git -C "$repo" branch --show-current)$([[ -z "$(git -C "$repo" status --porcelain -- src mutator pyproject.toml)" ]] || echo ' + uncommitted changes')"
    echo "cores:    $(nproc) (one worker per core by default)"
    ;;
  project)
    [[ $# -eq 2 ]] || usage
    scratch=$(mktemp -d "${scratch_prefix}XXXXXX")
    if [[ $2 == fixture ]]; then
      write_fixture "$scratch/project"
    elif [[ $2 == cold-build ]]; then
      write_cold_build "$scratch/project"
    else
      git clone -q -- "$2" "$scratch/project"
    fi
    # A project's own measure script finds mutator through MEASURE_TOOLS; point it at this checkout.
    mkdir -p "$scratch/tools"
    for tool in mutator crapper dryer; do
      source=$repo
      [[ $tool == mutator ]] || source=$(realpath -m -- "$repo/../$tool")
      ln -s "$source" "$scratch/tools/$tool"
    done
    echo "$scratch/project"
    ;;
  drive)
    [[ $# -ge 3 ]] || usage
    project=$2 transcript=$3
    shift 3
    admit drive "$project"
    record "$project" "$transcript" "mutator$(printf ' %q' "$@")" "$mutator" "$@"
    ;;
  exec)
    [[ $# -ge 4 ]] || usage
    project=$2 transcript=$3
    shift 3
    admit exec "$project"
    record "$project" "$transcript" "$(printf '%q ' "$@")" "$@"
    ;;
  signal)
    [[ $# -ge 5 && ( $4 == TERM || $4 == INT ) ]] || usage
    project=$2 transcript=$3 sig=$4 after=$5
    shift 5
    admit signal "$project"
    # timeout sends the signal to this mutator only (test commands run in their own sessions),
    # and SIGKILL 2 s later if it is still running. A shell can start a job with SIGINT ignored,
    # so Python resets it to the default first, as Ctrl-C at a terminal would find it.
    record "$project" "$transcript" "timeout -k 2 -s $sig $after mutator$(printf ' %q' "$@")" \
      "$repo/.venv/bin/python" -c 'import os, signal, sys; signal.signal(signal.SIGINT, signal.SIG_DFL); os.execvp(sys.argv[1], sys.argv[1:])' \
      timeout -k 2 -s "$sig" --preserve-status "$after" "$mutator" "$@"
    ;;
  trace)
    [[ $# -ge 3 ]] || usage
    project=$2 transcript=$3
    shift 3
    admit trace "$project"
    command -v strace >/dev/null || { echo "trace: strace is not installed, so the signal order can't be checked; install it (pacman -S strace, or apt install strace)"; exit 1; }
    log=$(mktemp)
    record "$project" "$transcript" "strace -f mutator$(printf ' %q' "$@")" \
      strace -f -qq -e trace=kill,wait4,waitid,clone,clone3,fork,vfork -e signal=none -o "$log" "$mutator" "$@"
    { echo "--- group signals sent after their leader was reaped (strace)"; signals_after_reap "$log"; echo; } | tee -a "$transcript"
    rm -f "$log"
    ;;
  cleanup)
    [[ $# -eq 2 ]] || usage
    root=$(scratch_root "$2") || { echo "cleanup: refusing to remove $2; it is not a verify-mutator scratch folder"; exit 1; }
    path=$(realpath -m -- "$2")
    [[ $path == "$root" || $path == "$root/project" ]] || { echo "cleanup: refusing to remove $2; pass the project or its scratch folder"; exit 1; }
    rm -rf -- "$root"
    echo "removed $root"
    ;;
  *) usage ;;
esac
